{
  "name": "hr-salary-management",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f postgres",
    "docker:ps": "docker-compose ps",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "migration:generate": "npx tsx ./node_modules/typeorm/cli.js migration:generate -d src/config/migration.config.ts",
    "migration:run": "npx tsx ./node_modules/typeorm/cli.js migration:run -d src/config/migration.config.ts",
    "migration:revert": "npx tsx ./node_modules/typeorm/cli.js migration:revert -d src/config/migration.config.ts",
    "graphql:generate": "npx tsx src/config/graphql.config.ts"
  },
  "dependencies": {
    "@nestjs/apollo": "^10.2.1",
    "@nestjs/common": "^9.0.0",
    "@nestjs/config": "^2.2.0",
    "@nestjs/core": "^9.0.0",
    "@nestjs/graphql": "^10.2.1",
    "@nestjs/platform-express": "^9.0.0",
    "@nestjs/typeorm": "^9.0.0",
    "apollo-server-express": "^3.11.1",
    "graphql": "^16.6.0",
    "pg": "^8.11.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "typeorm": "^0.3.17"
  },
  "devDependencies": {
    "@nestjs/cli": "^9.0.0",
    "@nestjs/schematics": "^9.0.0",
    "@nestjs/testing": "^9.0.0",
    "@types/express": "^4.17.17",
    "@types/node": "^20.11.0",
    "prettier": "^3.0.0",
    "ts-morph": "^17.0.1",
    "ts-node": "^10.9.1",
    "tsx": "^4.11.0",
    "typescript": "^5.6.0"
  }
}
