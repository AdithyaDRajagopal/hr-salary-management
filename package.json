{
  "name": "hr-salary-management",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build",
    "prebuild": "rimraf dist",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "format": "prettier --write \"src/**/*.ts\"",
    "typeorm": "npx tsx ./node_modules/typeorm/cli.js -d src/config/migration.config.ts",
    "migration:generate": "npm run typeorm -- migration:generate src/migrations/$npm_config_name",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "graphql:generate": "npx tsx src/config/graphql.config.ts",
    "seed:employees": "npx tsx scripts/seed-employees.ts"
  },
  "dependencies": {
    "@nestjs/apollo": "^10.2.1",
    "@nestjs/common": "^9.0.0",
    "@nestjs/config": "^2.2.0",
    "@nestjs/core": "^9.0.0",
    "@nestjs/graphql": "^10.2.1",
    "@nestjs/platform-express": "^9.0.0",
    "@nestjs/typeorm": "^9.0.0",
    "apollo-server-express": "^3.11.1",
    "graphql": "^16.6.0",
    "pg": "^8.11.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "typeorm": "^0.3.17"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@nestjs/cli": "^9.0.0",
    "@nestjs/schematics": "^9.0.0",
    "@nestjs/testing": "^9.0.0",
    "@types/express": "^4.17.17",
    "@types/node": "^20.11.0",
    "prettier": "^3.0.0",
    "ts-morph": "^17.0.1",
    "ts-node": "^10.9.1",
    "tsx": "^4.11.0",
    "typescript": "^5.6.0",
    "uuid": "^14.0.1"
  }
}
